@article{McEnroe2025,
  title = {Benzotriazole ({{BTA}}): {{A Review}} of the {{Current Research}} into {{Toxicity}}},
  shorttitle = {Benzotriazole ({{BTA}})},
  author = {McEnroe, Kate and Lobley, Isabelle and Kerns, Abigail},
  date = {2025-10-02},
  journaltitle = {Journal of the American Institute for Conservation},
  volume = {64},
  number = {4},
  pages = {285--302},
  publisher = {Routledge},
  issn = {0197-1360},
  doi = {10.1080/01971360.2025.2475546},
  url = {https://doi.org/10.1080/01971360.2025.2475546},
  urldate = {2026-03-07},
  abstract = {This review aims to appraise the current state of research on safe practice for benzotriazole (BTA) use by conservators. Employed as a corrosion inhibitor when treating copper alloys, concerns about BTA safety were raised in the 1970s and have never been fully contextualized. The authors summarize published research and focus on three assessments released by international governments. The article also reviews the chemical action of BTA and typical application methods. Health and safety concerns are addressed, and engineering controls and personal protective equipment (PPE) are recommended. Research into environmental toxicity is also presented, illustrating another avenue of concern. Finally, the article offers additional avenues for future research and mentions ongoing experimentation with organic, non-toxic corrosion inhibitor alternatives.},
  keywords = {benzotriazole (BTA),carcinogenicity,Copper alloys,corrosion,corrosion inhibitor,health and safety,sustainability,toxicity}
}

